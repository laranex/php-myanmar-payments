{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laranex/php-myanmar-payments",
    "description": "PHP SDK for Myanmar payment gateways: KBZ Pay, Wave Money, AYA Pay, Yoma MMQR and CyberSource. Typed requests and results, exact amounts, works with any PSR-18 HTTP client.",
    "keywords": [
        "php",
        "laranex",
        "php-myanmar-payments",
        "myanmar",
        "payments",
        "payment-gateway",
        "kbzpay",
        "wavemoney",
        "ayapay",
        "yoma",
        "mmqr",
        "cybersource",
        "psr-18"
    ],
    "homepage": "https://laranex.vercel.app/php-myanmar-payments",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nay Thu Khant",
            "email": "naythukhant644@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "php-http/discovery": "^1.9.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0||^2.0",
        "psr/simple-cache": "^2.0||^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.20||^1.29",
        "pestphp/pest": "^2.36||^3.0||^4.6",
        "pestphp/pest-plugin-type-coverage": "^2.8.7||^3.0||^4.0",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^1.12.5||^2.1"
    },
    "autoload": {
        "psr-4": {
            "Laranex\\PhpMyanmarPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laranex\\PhpMyanmarPayments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint"
        ],
        "lint:check": [
            "vendor/bin/pint --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=-1 vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-z3gr-8qht-p93v": "Dev-only: Pest 2.36.0 (the last release supporting PHP 8.1) pins PHPUnit 10.5.36. The advisory concerns PHPT code-coverage handling, which this suite does not use."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-dev": "4.x-dev",
            "dev-main": "4.x-dev"
        }
    }
}
